{
  "name": "mmm-worldmaptravelcollector",
  "version": "1.0.0-rc.1",
  "description": "MagicMirror² module that maps everywhere you've traveled, solo or together, with a notebook-style ledger of places and dates, travel stats, and a phone-friendly editor.",
  "type": "commonjs",
  "main": "MMM-WorldMapTravelCollector.js",
  "author": "I-dontknowwhatImdoing",
  "license": "MIT",
  "homepage": "https://github.com/I-dontknowwhatImdoing/MMM-WorldMapTravelCollector#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/I-dontknowwhatImdoing/MMM-WorldMapTravelCollector.git"
  },
  "bugs": {
    "url": "https://github.com/I-dontknowwhatImdoing/MMM-WorldMapTravelCollector/issues"
  },
  "keywords": [
    "MagicMirror",
    "module",
    "travel",
    "travel map",
    "world map",
    "places visited",
    "travel tracker",
    "map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "build:geo": "node scripts/build-geo.js",
    "import": "node scripts/import.js",
    "preview": "node scripts/preview.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "lib/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 80,
        "functions": 90,
        "statements": 90
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "all-the-cities": "^3.1.0",
    "countries-list": "^3.4.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "i18n-iso-countries": "^7.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "fast-xml-parser": "^5.12.1",
    "qrcode-generator": "^2.0.4",
    "topojson-client": "^3.1.0"
  }
}
